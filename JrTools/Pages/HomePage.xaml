<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JrTools.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JrTools.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Estilo para os cards principais -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Estilo para os painéis de indicadores no topo -->
        <Style x:Key="DashboardTileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="MinWidth" Value="200"/>
        </Style>




        <!-- Novo estilo para o card de terminal, que ocupa a largura total -->
        <Style x:Key="FullWidthCardStyle" TargetType="Border" BasedOn="{StaticResource ResponsiveCardStyle}">
            <Setter Property="MaxWidth" Value="9999"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Novo estilo para Expander que ocupa largura total -->
        <Style x:Key="FullWidthExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Page.Resources>
    
    

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel Spacing="16">

                <!-- Título da Página -->
                <TextBlock Text="Dashboard" Style="{ThemeResource TitleTextBlockStyle}" Margin="8,0"/>

                <!-- Painéis de Indicadores -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Banco de Horas -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardTileStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Banco de Horas" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                            <TextBlock x:Name="BancoDeHorasText"  Text="42h 30m" Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Previsão de Saída -->
                    <Border Grid.Column="1" Style="{StaticResource DashboardTileStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Previsão de Saída (Hoje)" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                            <TextBlock x:Name="HorariosaidaPrevistaText"  Text="17:45" Style="{ThemeResource HeaderTextBlockStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Economia Mensal -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardTileStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Horas lançadas hoje (Toggl)" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                            <TextBlock x:Name="TotalHorasLancadas" Text="0h" Style="{ThemeResource HeaderTextBlockStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Aviso de nova versão disponível (auto-update) -->
                <InfoBar x:Name="AtualizacaoInfoBar"
                         Severity="Informational"
                         Title="Nova versão disponível"
                         IsOpen="False"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="BtnAtualizarVersao" Content="Atualizar agora" Click="BtnAtualizarVersao_Click"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- EXPANDER BUILDAR DOTNET -->
                <Expander  x:Name="ExpanderCalculadoraHoras"  Style="{StaticResource FullWidthExpanderStyle}" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Calculadora de Horas" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Spacing="16" Margin="0,16,0,0">

                            <!-- Card: Calculadora de Horas -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12"> 

                                    <Grid ColumnSpacing="24" RowSpacing="12" MaxWidth="500">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Entrada 1" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <NumberBox x:Name="Entrada1HoraBox" Width="70" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="HH"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                                                <NumberBox x:Name="Entrada1MinutoBox" Width="70" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="MM"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Saída 1" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <NumberBox x:Name="Saida1HoraBox" Width="70" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="HH"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                                                <NumberBox x:Name="Saida1MinutoBox" Width="70" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="MM"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Entrada 2" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <NumberBox x:Name="Entrada2HoraBox" Width="70" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="HH"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                                                <NumberBox x:Name="Entrada2MinutoBox" Width="70" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="MM"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Saída 2" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <NumberBox x:Name="Saida2HoraBox" Width="70" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="HH"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                                                <NumberBox x:Name="Saida2MinutoBox" Width="70" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" SmallChange="1" PlaceholderText="MM"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button x:Name="CalcularHorasButton" Content="Calcular" Grid.Row="2" Grid.Column="0" Click="CalcularHorasButton_Click"/>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Total:" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock x:Name="TotalHorasTextBlock" Text="00:00" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="18"/>
                                        </StackPanel>

                                        <InfoBar x:Name="CalculadoraInfoBar" Grid.Row="3" Grid.ColumnSpan="2" IsOpen="False" Severity="Error" Margin="0,12,0,0"/>

                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>  
                <!-- EXPANDER BUILDAR DOTNET -->
                <Expander  x:Name="ExpanderManterFechado"  Style="{StaticResource FullWidthExpanderStyle}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Manter processos fechados" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                            <!-- Dentro do seu HomePage.xaml -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Frame x:Name="InnerFrame"  />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
